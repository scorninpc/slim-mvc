{
    "name": "scorninpc/slim-mvc",
    "version": "3.0.0",
    "type": "library",
    "description": "Slim Framework 4 bootstrap to call simple MVC structure",
    "keywords": ["slim","framework","slim 4","bootstrap","mvc"],
    "license": "MIT",
    "authors": [
        {
            "name": "Bruno Pitteli Gonçalves",
            "email": "scorninpc@php.net",
            "homepage": "https://andor.com.br"
        }
    ],
    "repositories": [
        {
            "type": "git",
            "url": "git@github.com:scorninpc/slim-smarty-view.git"
        }
    ],

    "minimum-stability": "dev",
    "prefer-stable": true,

    "require": {
        "slim/slim": "^4.0",
        "slim/psr7": "*",
        "php-di/php-di": "*",
        "scorninpc/slim-smarty-view": "3.0.0.x-dev"
    },
    "autoload": {
        "psr-4": {
            "Slim\\Mvc\\": "src"
        }
    }
}